{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "orange",
      "green",
      "violet",
      "blue",
      "red",
      "yellow",
      "aqua",
      "pink"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.300"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.700",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.violet.400",
      "function": "$hue.blue.400",
      "variable": "$hue.neutral.100",
      "string": "$hue.green.500",
      "number": "$hue.pink.400",
      "type": "$hue.aqua.400",
      "operator": "$hue.red.400",
      "punctuation": "$hue.neutral.300"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.yellow.400",
      "link": "$hue.blue.400",
      "linkText": "$hue.neutral.300",
      "code": "$hue.orange.400",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.neutral.100",
      "strong": "$hue.neutral.100",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.neutral.100",
      "listEnumeration": "$hue.orange.400",
      "image": "$hue.blue.400",
      "imageText": "$hue.neutral.300",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#c5c9c5",
        "200": "#a6a69c",
        "300": "#9e9b93",
        "400": "#7a8382",
        "500": "#625e5a",
        "600": "#393836",
        "700": "#282727",
        "800": "#1d1c19",
        "900": "#181616"
      },
      "orange": {
        "100": "#f0dccd",
        "200": "#d9b8a1",
        "300": "#c4a28a",
        "400": "#b6927b",
        "500": "#b98d7b",
        "600": "#7d6352",
        "700": "#3d3129",
        "800": "#2a221c",
        "900": "#1b1612"
      },
      "yellow": {
        "100": "#f2ead4",
        "200": "#e6c384",
        "300": "#d6c08f",
        "400": "#c4b28a",
        "500": "#a8966f",
        "600": "#6e6248",
        "700": "#3a3427",
        "800": "#27231b",
        "900": "#1a1712"
      },
      "red": {
        "100": "#f6dcdc",
        "200": "#e46876",
        "300": "#d68a85",
        "400": "#c4746e",
        "500": "#a35d58",
        "600": "#6b3d3a",
        "700": "#432a28",
        "800": "#2d1f1f",
        "900": "#1d1414"
      },
      "green": {
        "100": "#e3ece0",
        "200": "#a8c8a8",
        "300": "#9cb89c",
        "400": "#87a987",
        "500": "#8a9a7b",
        "600": "#5a6e5a",
        "700": "#2b362b",
        "800": "#1e2a1e",
        "900": "#141c14"
      },
      "blue": {
        "100": "#e2ebf0",
        "200": "#a9bfca",
        "300": "#9db3be",
        "400": "#8ba4b0",
        "500": "#738c98",
        "600": "#4c5f68",
        "700": "#2c363b",
        "800": "#1f2629",
        "900": "#151b1d"
      },
      "violet": {
        "100": "#e6e8ef",
        "200": "#b4bacb",
        "300": "#9fa6ba",
        "400": "#8992a7",
        "500": "#737c91",
        "600": "#4d5463",
        "700": "#2e323b",
        "800": "#21242b",
        "900": "#16181d"
      },
      "pink": {
        "100": "#ede6ee",
        "200": "#c0b3c1",
        "300": "#b1a2b2",
        "400": "#a292a3",
        "500": "#8a7b8b",
        "600": "#5c515d",
        "700": "#352f36",
        "800": "#252126",
        "900": "#191619"
      },
      "aqua": {
        "100": "#e2ecea",
        "200": "#b0c4c2",
        "300": "#9fb4b2",
        "400": "#8ea4a2",
        "500": "#788d8b",
        "600": "#4f5f5d",
        "700": "#2d3736",
        "800": "#202726",
        "900": "#151a1a"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    }
  }
}
