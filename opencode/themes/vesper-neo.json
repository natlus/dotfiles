{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "orange",
      "green",
      "purple",
      "blue",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.orange.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.accent.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#282828"
    },
    "scrollbar": {
      "base": "#505050"
    },
    "diff": {
      "text": {
        "added": "#99FFE4",
        "removed": "#FF8080",
        "context": "#A0A0A0",
        "hunkHeader": "#A0A0A0"
      },
      "background": {
        "added": "#0d2818",
        "removed": "#281a1a",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "#C2FFEF",
        "removed": "#FFAAAA"
      },
      "lineNumber": {
        "text": "#505050",
        "background": {
          "added": "#0a2014",
          "removed": "#201515"
        }
      }
    },
    "syntax": {
      "comment": "#8b8b8b",
      "keyword": "#A0A0A0",
      "function": "#FFC799",
      "variable": "#FFFFFF",
      "string": "#99FFE4",
      "number": "#FFC799",
      "type": "#FFC799",
      "operator": "#A0A0A0",
      "punctuation": "#FFFFFF"
    },
    "markdown": {
      "text": "#FFFFFF",
      "heading": "#FFC799",
      "link": "#FFC799",
      "linkText": "#A0A0A0",
      "code": "#A0A0A0",
      "blockQuote": "#FFFFFF",
      "emphasis": "#FFFFFF",
      "strong": "#FFFFFF",
      "horizontalRule": "#65737E",
      "listItem": "#FFFFFF",
      "listEnumeration": "#FFFFFF",
      "image": "#FFC799",
      "imageText": "#A0A0A0",
      "codeBlock": "#FFFFFF"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#101010",
        "200": "#505050",
        "300": "#8b8b8b",
        "400": "#b5b5b5",
        "500": "#e6e6e6",
        "600": "#eeeeee",
        "700": "#f2f2f2",
        "800": "#f7f7f7",
        "900": "#ffffff"
      },
      "orange": {
        "100": "#2e241b",
        "200": "#7d6a5a",
        "300": "#af9a88",
        "400": "#c97a3a",
        "500": "#f0c9a6",
        "600": "#ffe0c7",
        "700": "#fff1e5",
        "800": "#fff8f2",
        "900": "#fffdfb"
      },
      "green": {
        "100": "#132e27",
        "200": "#5e7d75",
        "300": "#8fb0a7",
        "400": "#1e9c80",
        "500": "#a8eedb",
        "600": "#cdf8ec",
        "700": "#e6fcf6",
        "800": "#f3fefa",
        "900": "#fbfffd"
      },
      "red": {
        "100": "#2e1b1b",
        "200": "#7e6d6d",
        "300": "#b09999",
        "400": "#d94f4f",
        "500": "#f0b8b8",
        "600": "#fbdada",
        "700": "#fdeaea",
        "800": "#fff6f6",
        "900": "#fffbfb"
      },
      "blue": {
        "100": "#1b1f2e",
        "200": "#6e7380",
        "300": "#9ba1b2",
        "400": "#6f86b8",
        "500": "#c0cbe2",
        "600": "#d8e0f0",
        "700": "#edf1f8",
        "800": "#f5f7fb",
        "900": "#fbfcfe"
      },
      "purple": {
        "100": "#231b2e",
        "200": "#74707c",
        "300": "#a29dae",
        "400": "#9a7fbf",
        "500": "#d2c6e3",
        "600": "#e8e0f4",
        "700": "#f2edf9",
        "800": "#f8f5fc",
        "900": "#fcfbfe"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "border": {
      "base": "#d0d0d0"
    },
    "scrollbar": {
      "base": "#b5b5b5"
    },
    "diff": {
      "text": {
        "added": "#1e9c80",
        "removed": "#d94f4f",
        "context": "#8b8b8b",
        "hunkHeader": "#8b8b8b"
      },
      "background": {
        "added": "#e6fcf6",
        "removed": "#fdeaea",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "#137a63",
        "removed": "#b83a3a"
      },
      "lineNumber": {
        "text": "#808080",
        "background": {
          "added": "#d6f5ec",
          "removed": "#f7dcdc"
        }
      }
    },
    "syntax": {
      "comment": "#8b8b8b",
      "keyword": "#707070",
      "function": "#c97a3a",
      "variable": "#101010",
      "string": "#1e9c80",
      "number": "#c97a3a",
      "type": "#c97a3a",
      "operator": "#707070",
      "punctuation": "#101010"
    },
    "markdown": {
      "text": "#101010",
      "heading": "#c97a3a",
      "link": "#c97a3a",
      "linkText": "#707070",
      "code": "#707070",
      "blockQuote": "#101010",
      "emphasis": "#101010",
      "strong": "#101010",
      "horizontalRule": "#b5b5b5",
      "listItem": "#101010",
      "listEnumeration": "#101010",
      "image": "#c97a3a",
      "imageText": "#707070",
      "codeBlock": "#101010"
    },
    "@dialog": {
      "background": {
        "base": "$hue.neutral.800",
        "raised": {
          "high": "$hue.neutral.700"
        },
        "action": {
          "primary": {
            "$hovered": "$hue.neutral.600"
          },
          "secondary": {
            "$hovered": "$hue.neutral.600"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#c8c8c8",
        "300": "#a0a0a0",
        "400": "#505050",
        "500": "#282828",
        "600": "#222222",
        "700": "#1c1c1c",
        "800": "#161616",
        "900": "#101010"
      },
      "orange": {
        "100": "#fff6ee",
        "200": "#ffe0c7",
        "300": "#e0b08a",
        "400": "#ffc799",
        "500": "#8f6e52",
        "600": "#45362a",
        "700": "#2c241d",
        "800": "#1b1612",
        "900": "#0d0907"
      },
      "green": {
        "100": "#effffa",
        "200": "#c2fff0",
        "300": "#80c9b6",
        "400": "#99ffe4",
        "500": "#4f8f7f",
        "600": "#25423b",
        "700": "#182e28",
        "800": "#0f1a17",
        "900": "#070d0b"
      },
      "red": {
        "100": "#fff2f2",
