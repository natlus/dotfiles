        "800": "#10141a",
        "900": "#080a0d"
      },
      "purple": {
        "100": "#f7f2ff",
        "200": "#bcb0cc",
        "300": "#8a7f9c",
        "400": "#bfa8e0",
        "500": "#64587a",
        "600": "#352f40",
        "700": "#221e2a",
        "800": "#141118",
        "900": "#0a080d"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    }
  }
}
