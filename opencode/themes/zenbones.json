{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "green",
      "pink",
      "orange",
      "red",
      "aqua"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.300"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.orange.300"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.700",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.neutral.100",
      "function": "$hue.neutral.100",
      "variable": "$hue.neutral.200",
      "string": "$hue.neutral.300",
      "number": "$hue.neutral.200",
      "type": "$hue.neutral.200",
      "operator": "$hue.neutral.300",
      "punctuation": "$hue.neutral.300"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.neutral.100",
      "link": "$hue.blue.400",
      "linkText": "$hue.neutral.300",
      "code": "$hue.neutral.200",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.neutral.200",
      "strong": "$hue.neutral.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.neutral.200",
      "listEnumeration": "$hue.neutral.300",
      "image": "$hue.blue.400",
      "imageText": "$hue.neutral.300",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#c4cacf",
        "200": "#b4bdc3",
        "300": "#888f94",
        "400": "#6e6763",
        "500": "#57504c",
        "600": "#403833",
        "700": "#352f2b",
        "800": "#26221f",
        "900": "#1c1917"
      },
      "blue": {
        "100": "#d6e6f2",
        "200": "#9cc3de",
        "300": "#61abda",
        "400": "#6099c0",
        "500": "#4d7a9a",
        "600": "#33516a",
        "700": "#243849",
        "800": "#1b2734",
        "900": "#141c24"
      },
      "red": {
        "100": "#f6dadd",
        "200": "#e8838f",
        "300": "#e3788a",
        "400": "#de6e7c",
        "500": "#b55a66",
        "600": "#6e3940",
        "700": "#45262b",
        "800": "#2e1c1f",
        "900": "#1f1415"
      },
      "green": {
        "100": "#e2ead9",
        "200": "#a9c28f",
        "300": "#8bae68",
        "400": "#819b69",
        "500": "#677c54",
        "600": "#435138",
        "700": "#2c3526",
        "800": "#20271c",
        "900": "#161b13"
      },
      "orange": {
        "100": "#f3e2d8",
        "200": "#e3ae92",
        "300": "#d68c67",
        "400": "#b77e64",
        "500": "#93654f",
        "600": "#5f4235",
        "700": "#3c2c24",
        "800": "#2a1f1a",
        "900": "#1d1612"
      },
      "pink": {
        "100": "#f1dfed",
        "200": "#dca9d0",
        "300": "#cf86c1",
        "400": "#b279a7",
        "500": "#8f6186",
        "600": "#5c3f57",
        "700": "#3b2a38",
        "800": "#2a1e28",
        "900": "#1d151c"
      },
      "aqua": {
        "100": "#dcf0f2",
        "200": "#9ad3d9",
        "300": "#65b8c1",
        "400": "#66a5ad",
        "500": "#52848b",
        "600": "#365759",
        "700": "#253b3d",
        "800": "#1b2a2b",
        "900": "#131d1e"
      },
      "accent": "$hue.blue",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
