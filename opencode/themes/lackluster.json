{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "lack",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.300"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.orange.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.lack.400"
        }
      }
    },
    "background": {
      "base": "#0a0a0a",
      "raised": {
        "base": "#141414",
        "high": "#1a1a1a",
        "max": "#222222"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "#1a1a1a",
          "$focused": "$hue.interactive.700",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#222222"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.orange.400",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.orange.800",
        "context": "#141414"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.orange.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.orange.900"
        }
      }
    },
    "syntax": {
      "comment": "#5f5f5f",
      "keyword": "#8e8e8e",
      "function": "#ffffff",
      "variable": "#cccccc",
      "string": "#708090",
      "number": "#ffffff",
      "type": "#ffffff",
      "operator": "#7a7a7a",
      "punctuation": "#7a7a7a"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.neutral.100",
      "link": "$hue.lack.400",
      "linkText": "$hue.neutral.300",
      "code": "$hue.lack.400",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.neutral.200",
      "strong": "$hue.neutral.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.neutral.200",
      "listEnumeration": "$hue.neutral.300",
      "image": "$hue.lack.400",
      "imageText": "$hue.neutral.300",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#dddddd",
        "200": "#cccccc",
        "300": "#aaaaaa",
        "400": "#7a7a7a",
        "500": "#555555",
        "600": "#444444",
        "700": "#2a2a2a",
        "800": "#191919",
        "900": "#101010"
      },
      "lack": {
        "100": "#e3e8ed",
        "200": "#b8c3ce",
        "300": "#94a3b2",
        "400": "#708090",
        "500": "#5a6774",
        "600": "#3d464f",
        "700": "#2a3036",
        "800": "#1c2024",
        "900": "#121416"
      },
      "green": {
        "100": "#e4ece4",
        "200": "#b4c9b4",
        "300": "#97b197",
        "400": "#789978",
        "500": "#5f7a5f",
        "600": "#3e503e",
        "700": "#2a362a",
        "800": "#1c241c",
        "900": "#121812"
      },
      "orange": {
        "100": "#fff1eb",
        "200": "#ffd4c3",
        "300": "#ffbfa5",
        "400": "#ffaa88",
        "500": "#cc886d",
        "600": "#7d5343",
        "700": "#4d3329",
        "800": "#2d1e18",
        "900": "#1a110e"
      },
      "red": {
        "100": "#ffe0e0",
        "200": "#ff8080",
        "300": "#e84040",
        "400": "#d70000",
        "500": "#a80000",
        "600": "#690000",
        "700": "#420000",
        "800": "#2a0000",
        "900": "#180000"
      },
      "accent": "$hue.lack",
      "interactive": "$hue.lack",
      "neutral": "$hue.gray"
    }
  }
}
