{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "autoupdate": true,
  "plugins": ["./usage"],
  "websearch": {
    "provider": "random"
  },
  "worktree": {
    "directory": ".claude/worktrees",
  },
  "experimental": {
    "todo": true,
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/jessul01/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
}
