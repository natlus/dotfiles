{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5.5",
  "update": "auto",
  "plugins": ["./usage"],
  "websearch": {
    "provider": "random"
  },
  "worktree": {
    "directory": ".claude/worktrees",
  },
  "experimental": {
    "todo": true,
  },
  // Built-in subagents inherit the session model; general can also edit.
  // Replaced by the pinned, read-only agents in ./agents.
  "agents": {
    "general": { "disabled": true },
    "explore": { "disabled": true },
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/jessul01/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
}
