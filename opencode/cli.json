{
  "theme": {
    "name": "vesper-neo"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered"
  },
  "animations": true,
  "autoupdate": true,
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "indicators": "numbers",
    "mode": "auto"
  },
  "prompt": {
    "paste": "full"
  },
  "plugins": ["./pr-info"]
}
